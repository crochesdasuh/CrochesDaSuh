# Copie para .env e preencha com os dados do projeto Supabase
# (Supabase → Project Settings → API Keys / Data API).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Número do WhatsApp da Suh: DDI + DDD + número, só dígitos (ex.: 5511987654321).
# Sem NEXT_PUBLIC_: fica só no servidor e nunca aparece na página.
WHATSAPP_NUMBER=55DDNUMERO
